# Copy to .env for local development. Never commit the real .env.
# In production these are set with `fly secrets set KEY=value`.

# Required in production (app refuses to start without it)
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_hex-32

# Paystack credentials (use LIVE keys in production, TEST keys locally)
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=

# Optional site settings
SITE_NAME=Blak Shepherd WEF
SITE_URL=https://www.blakshepardwef.org

# Local only: set FLASK_DEBUG=1 to enable the debugger when running `python app.py`
# FLASK_DEBUG=1
